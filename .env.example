BANKER_HUB_URL=http://127.0.0.1:8080
BANKER_HUB_TOKEN=change-me
BANKER_HUB_TIMEOUT=15
BANKER_HUB_INCLUDE_DETAIL=false
# Redact counterparty names/identifiers from `description` (only applies when INCLUDE_DETAIL=false)
BANKER_HUB_REDACT_COUNTERPARTY=true
# Allow plain http to a non-loopback host (token is sent in clear)
BANKER_HUB_ALLOW_INSECURE=false
# Alternate .env path (default: .env in the working directory)
# BANKER_HUB_ENV_FILE=/path/to/.env
